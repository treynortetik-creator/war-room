# WarRoom Environment Variables
# Copy this file to .env.local and fill in values

# Required: Password for the War Room auth gate
WARROOM_PASSWORD=your-secure-password-here

# Required: SITREP API key for task/brief data
SITREP_API_KEY=your-sitrep-api-key

# Optional: Base URL of your SITREP instance (default: https://sitrep.example.com)
SITREP_API_URL=https://sitrep.example.com

# Optional: Session expiry in hours (default: 24)
SESSION_EXPIRY_HOURS=24

# Optional: Local agent runtime session-log directory, for local-deployment
# stats detection (default: ~/.agent-runtime/sessions)
AGENT_SESSIONS_DIR=
